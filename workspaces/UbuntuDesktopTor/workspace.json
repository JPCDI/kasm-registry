{
  "description": "Ubuntu Focal Desktop for TOR",
  "docker_registry": "https://ghcr.io/",
  "image_src": "ubuntu.png",
  "run_config": {
    "hostname": "kasm",
    "dns": [
      "1.1.1.1",
      "1.0.0.1"
    ]
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    },
    "first_launch":{
      "user":"root",
      "privileged":true,
      "cmd":"bash -c 'ip route delete default && ip route add default via 172.20.0.2'"
   }
  },
  "categories": [
    "Desktop"
  ],
  "friendly_name": "Ubuntu Desktop Tor",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "jpartain89/kasm-ubuntu-desktop-vlc-tor:latest",
      "uncompressed_size_mb": 2170
    }
  ]
}
